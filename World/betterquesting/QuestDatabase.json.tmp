					"repeatTime:3": -1,
					"notification_pos_x:3": -2147483648,
					"particle_count:3": -1,
					"countAsQuest:1": 1,
					"autoClaim:1": 0,
					"globalShare:1": 1,
					"desc:8": "Now that you've made some tools, you can start getting into some real agriculture. Get ready to craft many more iron saws...\n\nWelcome to CropsNH, the premier passive resource production mo... wait sorry I'm hearing just now that Bees do in fact still exist.\n\nAnyways, if you want to learn how to till your way to the Stargate, with the passive resources needed throughout much of your progression, this is the place to be.\n\nThe first step will be obtaining a stock of basic crops which you can breed from. If you don't already have them go steal some from those villagers, or that witch down the hill.\n\n[warn]CropsNH crops do not behave the same as IC2 Crops. These quests will walk you through how they work, it's recommended that you give them a read if it's your first time using them.[/warn]",
					"notification_icon_scale:5": -1.0,
					"notification_show_icon:8": "default",
					"notification_fade_in:5": -1.0,
					"icon:10": {
						"id:8": "harvestcraft:carrotsoupItem",
