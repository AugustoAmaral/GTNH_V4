			"properties:10": {
				"betterquesting:10": {
					"notification_pos_y:3": -2147483648,
					"notification_subtitle_scale:5": -1.0,
					"visibility:8": "NORMAL",
					"partySingleReward:1": 0,
					"notification_style:8": "default",
					"completion_particle:8": "default",
					"notification_duration:5": -1.0,
					"isMain:1": 0,
					"lockedProgress:1": 0,
					"repeat_relative:1": 1,
					"notification_fade_out:5": -1.0,
					"snd_complete:8": "random.levelup",
					"repeatTime:3": 1728000,
					"notification_pos_x:3": -2147483648,
					"particle_count:3": -1,
					"countAsQuest:1": 1,
					"autoClaim:1": 0,
					"globalShare:1": 1,
					"desc:8": "For the magic map you need the magic map focus and a paper stack, made from a stack of paper.\n\nIt will fill in the area near you, and reveal boss locations. You need to kill these to get access to the rest of the Twilight Forest. Start with the Naga.\n\nYou can see what to do next in the TF achievement tab. There's also quests for the boss kills on the kill all the things tab. You can only get one map every 24 hours, so be careful with it.\n\n§4Only use the map in the Twilight Forest, using the map in any other dimension will lag the server!",
					"notification_icon_scale:5": -1.0,
					"notification_show_icon:8": "default",
					"notification_fade_in:5": -1.0,
