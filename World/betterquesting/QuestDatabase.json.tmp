					"snd_complete:8": "random.levelup",
					"repeatTime:3": -1,
					"notification_pos_x:3": -2147483648,
					"particle_count:3": -1,
					"countAsQuest:1": 1,
					"autoClaim:1": 0,
					"globalShare:1": 1,
					"desc:8": "Kinetic generator compatibility has been improved so that you no longer need transformers, you can connect directly with a cable. But why not use your transformer to send the power back to base more efficiently, it's a loss of about 97EU per HV amp just going from 160 straight down to 63 without it. If you transform up (after going through 1 block of cable to transform it to GT power), you only lose about 97EU per EV amp, which saves 4x the energy in regard to cable loss.\n\n[warn]IC2 machines don't care about rain, but remember to cover your transformer.[/warn]",
					"notification_icon_scale:5": -1.0,
					"notification_show_icon:8": "default",
					"notification_fade_in:5": -1.0,
