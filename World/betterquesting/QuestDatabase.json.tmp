					"autoClaim:1": 0,
					"globalShare:1": 0,
					"desc:8": "The §5§lStreamlined Casters§r (SC) module is one of the first three modules you unlock right away for use in the §nExo-Foundry§r.\n\nThe SC module functions as a powerful §2150%§r speed bonus for the Foundry. If that's not enough for you, you can further amplify by another §2150%§r for every SC module you install.\n\nIf this module paired with §5Superdense Casting Basins§r (SCB) module, you will unlock the \"§6Optimum Production§r\" bonus for §38§r extra parallels per voltage tier and a further §280%§r speed increase.\n\n[note]This bonus is stackable with bonuses obtained from other modules you will unlock in the future![/note]",
					"notification_icon_scale:5": -1.0,
					"notification_show_icon:8": "default",
					"notification_fade_in:5": -1.0,
