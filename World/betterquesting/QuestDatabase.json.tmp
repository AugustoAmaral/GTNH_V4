					"particle_count:3": -1,
					"countAsQuest:1": 1,
					"autoClaim:1": 0,
					"globalShare:1": 0,
					"desc:8": "The §5§lProto-Volt Stabilizer§r (PVS) module is one of the first three modules you unlock right away for use in the §nExo-Foundry§r.\n\nThe PVS module is a welcome addition for those who want to save power. It will give an EU discount equal to §2(100 - ((100 - 10x) * 0.8^x))%§r where x is the number of PVS modules installed to the Foundry. \n\nSo, for a T1 Foundry, you can attain a §c28%§r EU discount with one PVS module, and a §c49%§r EU discount with two.\n\n[note]This can be combined with other modules unlocked in the future for further EU discounts and other special effects![/note]",
					"notification_icon_scale:5": -1.0,
					"notification_show_icon:8": "default",
					"notification_fade_in:5": -1.0,
