			"properties:10": {
				"betterquesting:10": {
					"notification_pos_y:3": -2147483648,
					"notification_subtitle_scale:5": -1.0,
					"visibility:8": "NORMAL",
					"notification_style:8": "default",
					"notification_duration:5": -1.0,
					"completion_particle:8": "default",
					"isMain:1": 0,
					"lockedProgress:1": 0,
					"repeat_relative:1": 1,
					"notification_fade_out:5": -1.0,
					"snd_complete:8": "random.levelup",
					"repeatTime:3": -1,
					"notification_pos_x:3": -2147483648,
					"particle_count:3": -1,
					"countAsQuest:1": 1,
					"autoClaim:1": 0,
					"globalShare:1": 0,
					"desc:8": "One of the main reasons for getting into CropsNH is the passive production of resources.\n\nThe many crops attached to this quest will generally provide you the direct resource you are looking for. This can be perfect for getting that extra bit of aluminium you need to push through MV, or for generating a passive amount of basic minerals long before any other techniques become available.\n\n§4Keep in mind the sub-soil requirements for these crops especially. §rTo passively produce aluminium, you will first need blocks of aluminium or bauxite ore.",
					"notification_icon_scale:5": -1.0,
					"notification_show_icon:8": "default",
