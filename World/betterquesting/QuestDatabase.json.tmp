			"properties:10": {
				"betterquesting:10": {
					"notification_pos_y:3": -2147483648,
					"notification_subtitle_scale:5": -1.0,
					"visibility:8": "NORMAL",
					"partySingleReward:1": 0,
					"notification_style:8": "default",
					"completion_particle:8": "default",
					"notification_duration:5": -1.0,
					"isMain:1": 1,
					"lockedProgress:1": 1,
					"repeat_relative:1": 1,
					"notification_fade_out:5": -1.0,
					"snd_complete:8": "random.levelup",
					"repeatTime:3": -1,
					"notification_pos_x:3": -2147483648,
					"particle_count:3": -1,
					"countAsQuest:1": 1,
					"autoClaim:1": 0,
					"globalShare:1": 1,
					"desc:8": "You have decided it's time to make some tasty pizza, but your fingers got burned badly. Reading an ancient cookbook you discovered a pair of magical items that would allow you to carry anything hot, even lava in a bucket.\n\n§5The gloves have to be placed in the Baubles ring slots. Order does not matter.\n\n§rFor the protection effect, the hot item has to be in your active slot. I wonder if there is some way to carry more than a few buckets at a time?",
					"notification_icon_scale:5": -1.0,
					"notification_show_icon:8": "default",
					"notification_fade_in:5": -1.0,
