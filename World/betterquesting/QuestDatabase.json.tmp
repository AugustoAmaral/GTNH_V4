			"properties:10": {
				"betterquesting:10": {
					"notification_subtitle_scale:5": -1.0,
					"notification_pos_y:3": -2147483648,
					"visibility:8": "NORMAL",
					"partySingleReward:1": 0,
					"notification_style:8": "default",
					"completion_particle:8": "default",
					"notification_duration:5": -1.0,
					"isMain:1": 1,
					"lockedProgress:1": 1,
					"repeat_relative:1": 1,
					"notification_fade_out:5": -1.0,
					"snd_complete:8": "random.levelup",
					"repeatTime:3": -1,
					"notification_pos_x:3": -2147483648,
					"particle_count:3": -1,
					"countAsQuest:1": 1,
					"autoClaim:1": 0,
					"globalShare:1": 1,
					"desc:8": "In order to craft even basic machines, you'll need new tools. Most of them can be replaced by machines later. For now, you should become familiar with each of their recipes, as you will need a lot of these tools, starting today.\n\nYour new tools can also be used to make Railcraft water tanks, a very useful multiblock considering the finite water feature.\n\nThere are also electric versions of the tools, you can upgrade later if you want. Also, there are many versions of the tools, they generally follow the same rules as tinkers parts in terms of how good they are, similarly to turbines. You can look at the spreadsheet for more info on GT tool stats.\n\nFor this quest, you can use whatever materials you want. The gem version of the saw is crafted differently to metal versions. Higher tier tools need steel or tungstensteel rods instead of sticks.\n\n[note]If you want to know the recipe for a tool using your specific material, be sure to take advantage of the magnifying glass icon at the top of the list of tools seen from viewing the recipe in NEI so you can search for the material easily. (Try it out using Iron for these quests!)[/note]",
					"notification_icon_scale:5": -1.0,
					"notification_show_icon:8": "default",
					"ignoreNBT:1": 1,
					"notification_fade_in:5": -1.0,
