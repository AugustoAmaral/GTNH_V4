			"properties:10": {
				"betterquesting:10": {
					"notification_pos_y:3": -2147483648,
					"notification_subtitle_scale:5": -1.0,
					"visibility:8": "NORMAL",
					"partySingleReward:1": 0,
					"notification_style:8": "default",
					"completion_particle:8": "default",
					"notification_duration:5": -1.0,
					"isMain:1": 0,
					"lockedProgress:1": 0,
					"repeat_relative:1": 1,
					"notification_fade_out:5": -1.0,
					"snd_complete:8": "random.levelup",
					"repeatTime:3": -1,
					"notification_pos_x:3": -2147483648,
					"particle_count:3": -1,
					"countAsQuest:1": 1,
					"autoClaim:1": 0,
					"globalShare:1": 1,
					"desc:8": "To power your farm and have it automatically harvest crops, you will need at least one farm gearbox to supply power. You can use either RF or EU. If you use EU, make sure to use a cable to allow conversion. Farm operations can be hastened with additional gearboxes.\n\nTesting has shown that splitting the amps to 4 gearboxes (4A ULV) works better than sending 1A LV to 4 gearboxes.\n\nA max sized CropsNH Crop farm (5x4x5) using all space possible with max stat seeds (31/31/31) on a fast crop needs only 6A ULV to keep up.\n\nSimilarly, a max sized small farm (3x4x3) using all space possible with max stat seeds (31/31/31) on a high tier, moderate speed crop needs only 4A ULV.\n\nSending more power to the same gearbox doesn't work. If it can get to max RF capacity but your farm can't keep up, sending more power won't help, so add more gearboxes.\n\nIn addition, you lose 2 EU from the energy emitting device for every Amp of ULV (which is only 8 to begin with), so it's not nearly as efficient as using LV or higher. Just keep in mind that more A to more gearboxes is better than to the same one.\n\nOf course, if you mix your slower crops with your faster ones, you aren't likely to need to min-max to this extent.",
					"notification_icon_scale:5": -1.0,
					"notification_show_icon:8": "default",
					"notification_fade_in:5": -1.0,
					"icon:10": {
						"id:8": "Forestry:ffarm",
						"Count:3": 1,
						"Damage:2": 2,
						"tag:10": {
